# Compiled C++ binaries (cpp/ has its own .gitignore for tv_dd, mumps_check)
archive/cpp/dd_solve
archive/cpp/dd_solve_1d
archive/cpp/dd_solve_2d
archive/cpp_minimal/tv_learn
archive/cpp/dd_solve_dataset
archive/cpp/dd_solve*_omp
archive/cpp/dd_solve*_prof
archive/cpp/ma97_smoke
archive/cpp/ma97_smoke_par
archive/cpp/mumps_smoke
*.o
*.dSYM/
*.dwarf
docs/
# Solver output (regenerated)
archive/cpp/results/
/results/
archive/cpp/plots/
archive/cpp/sol_*.txt
archive/cpp/dd_*.txt
archive/cpp/*.png
*.slurm
runs/sols

# SLURM logs. The (archived) batch scripts write %x_%j.out/.err into
# SLURM_SUBMIT_DIR, which can be anywhere in the repo, so these are global. Nothing tracked has
# either extension; re-check before adding one that should be committed.
*.out
*.err
slurm-*.out

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
# uv: the environment is disposable (.venv above), the lockfile is NOT —
# python/uv.lock is committed so `uv sync` reproduces the exact versions a
# recorded run used.
.uv-cache/

# Rendered figures at the top level / python side
python/*.png
*.png

# OS / editor cruft
.DS_Store
*.swp

# Keep the bundled test images and data despite the *.png / .txt rules above.
# images/ is the package's image directory — everything in it is deliberate, so
# negate the whole thing rather than naming files one at a time (naming them is
# how mariposa.png silently failed to be added the first time).
!images/*.png
!python/images/*.png
!archive/cpp/data/*.txt

runs/sols
